{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/easy-sudoku", "destination": "/easy-sudoku.html" },
    { "source": "/medium-sudoku", "destination": "/medium-sudoku.html" },
    { "source": "/hard-sudoku", "destination": "/hard-sudoku.html" },
    { "source": "/expert-sudoku", "destination": "/expert-sudoku.html" },
    { "source": "/daily", "destination": "/daily.html" },
    { "source": "/how-to-play", "destination": "/how-to-play.html" },
    { "source": "/leaderboard", "destination": "/leaderboard.html" },
    { "source": "/printable", "destination": "/printable.html" },
    { "source": "/about", "destination": "/about.html" },
    { "source": "/contact", "destination": "/contact.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/privacy-policy", "destination": "/privacy.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/terms-of-service", "destination": "/terms.html" },
    { "source": "/cookies", "destination": "/cookies.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/ads.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" }
      ]
    },
    {
      "source": "/app-ads.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/favicon/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000" }
      ]
    }
  ]
}